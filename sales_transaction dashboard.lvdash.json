{
  "datasets": [
    {
      "name": "a6724589",
      "displayName": "sales_transactions",
      "queryLines": [
        "SELECT * FROM samples.bakehouse.sales_transactions"
      ]
    },
    {
      "name": "dd84a138",
      "displayName": "product_sales_desc",
      "queryLines": [
        "SELECT product, SUM(totalPrice) as Total_Price\r\n",
        "FROM samples.bakehouse.sales_transactions\r\n",
        "GROUP BY product\r\n",
        "ORDER BY  Total_Price DESC"
      ]
    }
  ],
